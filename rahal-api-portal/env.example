# ── REQUIRED FOR PRODUCTION ──────────────────────────────────────────────
# Copy this file to .env.local for local dev, or set these as encrypted
# environment variables in your hosting platform (Render/Vercel dashboard).
# NEVER commit an actual .env file with real values to git.

# Static API key the HRIS/admin system uses to call the provisioning
# endpoint (POST /api/admin/staff/provision). Generate with:
#   openssl rand -base64 32
# Rotate periodically. In a real deployment, prefer mTLS or OAuth2
# client-credentials over a static key — see lib/security/adminAuth.js
INTERNAL_PROVISIONING_API_KEY=

# RS256 keypair for JWT signing. Generate once, offline:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste each PEM's contents below with literal \n for line breaks,
# or use your platform's multi-line secret support if available.
# If left unset, the app auto-generates an ephemeral keypair at boot —
# fine for local dev, NOT acceptable for production (tokens stop
# verifying on every restart, and you have no key rotation control).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

NODE_ENV=production

# ── RAHAL BACKEND INTEGRATION (real backend, once IT grants access) ─────
# Base URL selection: 'stafftravel' (Former Staff/QAA-QEEL/OAL) or
# 'active' (Active QR Staff via rahal.qatarairways.com.qa)
RAHAL_AUDIENCE=stafftravel

# Basic Auth — service-to-service identity, issued by QR IT during
# onboarding. Never the same as any individual staff member's credentials.
RAHAL_BA_CLIENT_ID=
RAHAL_BA_CLIENT_SECRET=

# Encryption keys (RSA, hybrid AES-256-GCM scheme — see lib/security/payloadCrypto.js)
#   RAHAL_ENCRYPTION_PUBLIC_KEY   — RAHAL's public key, THEY provide this.
#                                   We use it to encrypt requests TO them.
#   CLIENT_ENCRYPTION_PRIVATE_KEY — OUR private key. WE generate this
#                                   ourselves and never send it anywhere.
#                                   RAHAL uses the matching public key
#                                   (which we DO send them) to encrypt
#                                   responses back to us.
# Generate our own keypair with:
#   openssl genrsa -out client_encryption_private.pem 2048
#   openssl rsa -in client_encryption_private.pem -pubout -out client_encryption_public.pem
# Send client_encryption_public.pem to QR IT; keep the private key local.
RAHAL_ENCRYPTION_PUBLIC_KEY=
CLIENT_ENCRYPTION_PRIVATE_KEY=

# Signing keys (RSA-SHA256, separate keypair from encryption above)
#   RAHAL_SIGNING_PUBLIC_KEY   — RAHAL's public key, used to verify
#                                THEIR responses were really signed by them.
#   CLIENT_SIGNING_PRIVATE_KEY — OUR private key, used to sign OUR
#                                requests so RAHAL can verify they came
#                                from us. Generate the same way as above
#                                (separate keypair, do not reuse):
#   openssl genrsa -out client_signing_private.pem 2048
#   openssl rsa -in client_signing_private.pem -pubout -out client_signing_public.pem
RAHAL_SIGNING_PUBLIC_KEY=
CLIENT_SIGNING_PRIVATE_KEY=

# ── PUBLIC KEY PUBLISHING (safe to expose) ───────────────────────────────
# These are the SAME public keys generated in the openssl commands above
# (client_signing_public.pem / client_encryption_public.pem), set here
# again explicitly so GET /api/security/public-keys can serve them.
# Safe to set as plain (non-secret) env vars — these are meant to be
# public. NEVER set a *_PRIVATE_KEY var to anything other than a value
# that stays server-side only.
CLIENT_SIGNING_PUBLIC_KEY=
CLIENT_ENCRYPTION_PUBLIC_KEY=

# ── REAL OTP DELIVERY ─────────────────────────────────────────────────────
# Required for POST /api/auth/otp/send to actually deliver a code
# instead of failing with OTP_DELIVERY_FAILED. You need real accounts
# with these providers — this project cannot create them for you.

# Email — any SMTP-compatible provider (Outlook/Office365, Gmail,
# SendGrid, Amazon SES, etc.). For Outlook/Office365 specifically:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=<your full email address>
#   SMTP_PASSWORD=<an App Password — NOT your regular login password,
#                   required if your account has 2FA enabled>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS — requires a Twilio account (twilio.com) with a verified
# sending number. Find these in the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

